[Unit]
Description=ukk local Agent Host (user session)
Documentation=https://github.com/suj1e/ukk
After=default.target

[Service]
Type=simple
ExecStart="{{EXE}}" serve
Restart=on-failure
RestartSec=2
# The Host is a metadata/RPC endpoint. KillMode=process makes sure a service
# stop never fans out a signal to herdr-core or Agent processes.
KillMode=process

[Install]
WantedBy=default.target
