{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ukk Agent snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider",
    "state",
    "turns",
    "messages",
    "tools",
    "pendingApprovals",
    "usage",
    "provenance",
    "updatedMs"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
    "providerSessionId": { "type": "string", "maxLength": 256 },
    "state": { "$ref": "#/$defs/state" },
    "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "pendingApprovals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "usage": { "$ref": "#/$defs/usage" },
    "error": { "$ref": "#/$defs/error" },
    "provenance": { "type": "string", "minLength": 1, "maxLength": 64 },
    "updatedMs": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "state": {
      "enum": ["idle", "running", "blocked", "done", "failed", "cancelled", "unknown"]
    },
    "role": {
      "enum": ["user", "assistant", "system", "tool", "unknown"]
    },
    "toolStatus": {
      "enum": ["pending", "running", "completed", "failed", "unknown"]
    },
    "approvalState": {
      "enum": ["pending", "approved", "denied", "cancelled", "expired"]
    },
    "errorCode": {
      "enum": [
        "invalid_argument",
        "session_not_found",
        "session_exists",
        "limit_exceeded",
        "unsupported",
        "not_running",
        "busy",
        "startup_failed",
        "protocol",
        "transport",
        "timeout",
        "child_exited",
        "rejected",
        "closed",
        "approval_not_found",
        "approval_settled",
        "diagnostic",
        "ui.unsupported",
        "turn_failed"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "maxLength": 2048 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "text", "final", "createdMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/role" },
        "text": { "type": "string" },
        "final": { "type": "boolean" },
        "createdMs": { "type": "integer", "minimum": 0 }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "startedMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "startedMs": { "type": "integer", "minimum": 0 },
        "endedMs": { "type": "integer", "minimum": 0 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "isError"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "turnId": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "input": {},
        "output": {},
        "status": { "$ref": "#/$defs/toolStatus" },
        "startedMs": { "type": "integer", "minimum": 0 },
        "endedMs": { "type": "integer", "minimum": 0 },
        "isError": { "type": "boolean" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "turnId": { "type": "string" },
        "toolName": { "type": "string" },
        "input": {},
        "state": { "$ref": "#/$defs/approvalState" },
        "expiresMs": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported",
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "totalTokens",
        "costUsd"
      ],
      "properties": {
        "reported": { "type": "boolean" },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cacheReadTokens": { "type": "integer", "minimum": 0 },
        "cacheWriteTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "contextTokens": { "type": "integer", "minimum": 0 },
        "reasoningTokens": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
